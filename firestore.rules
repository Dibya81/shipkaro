rules_version = '2';

// ShipKaro Firestore security rules
// The browser never talks to Firestore directly. All reads and writes go
// through the Next.js API routes (/api/requests, /api/admin), which use the
// Firebase Admin SDK with a service account. The Admin SDK bypasses these
// rules, so everything here is denied to clients.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
